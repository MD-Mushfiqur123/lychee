# Auto detect text files and perform LF normalization
* text=auto

# Go files
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Documentation
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.gguf binary
*.safetensors binary
*.bin binary
*.png binary
*.jpg binary
*.svg binary

# Lock files
vendor/ linguist-vendored
