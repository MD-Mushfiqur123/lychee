# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID
DISCORD_CLIENT_ID=your_application_id_here

# Discord Server ID (optional — omit for global commands)
DISCORD_GUILD_ID=

# Lychee API endpoint (for /lychee-status)
LYCHEE_API_URL=http://localhost:11434

# Channel IDs
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
SHOWCASE_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# Logging level: debug, info, warn, error
LOG_LEVEL=info
